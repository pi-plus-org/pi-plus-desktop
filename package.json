{
	"name": "pi-plus-desktop",
	"version": "0.1.17",
	"description": "Desktop app for pi-plus: multi-tab AI agent sessions with profile management, built on pi-plus-sdk.",
	"type": "module",
	"main": "dist/main.js",
	"scripts": {
		"dev": "node scripts/dev.mjs",
		"build": "node devops/module/build.mjs",
		"start": "electron .",
		"typecheck": "tsc --noEmit",
		"smoke": "node scripts/smoke.mjs",
		"test:thinking": "node scripts/test-thinking-dom.mjs",
		"test:panels": "node scripts/test-panel-fold.mjs",
		"test:history": "node scripts/test-composer-history.mjs",
		"test:scroll": "node scripts/test-tab-scroll.mjs",
		"test:steer-queue": "node scripts/test-steer-queue.mjs",
		"test:steer-e2e": "node scripts/test-steer-e2e.mjs",
		"test:steer-longtool": "node scripts/test-steer-longtool.mjs",
		"icon": "electron scripts/make-icon.mjs && node scripts/make-ico.mjs"
	},
	"dependencies": {
		"dompurify": "^3.2.4",
		"marked": "^15.0.7",
		"pi-plus-sdk": "^0.2.23"
	},
	"devDependencies": {
		"@types/node": "^22.13.0",
		"electron": "^39.0.0",
		"esbuild": "^0.25.0",
		"typescript": "^5.8.0"
	}
}
